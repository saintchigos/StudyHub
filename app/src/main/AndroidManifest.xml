<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Keeps the CPU on while the ringtone loops. Without it Android throws
         SecurityException inside AlarmService on a locked screen. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- From Android 13 USE_EXACT_ALARM is granted automatically, so the user-facing
         permission is only needed on 12 and 12L. -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Lets the reliability check open the "don't optimise this app" prompt, which is
         the single biggest fix for alarms that never ring on Tecno, Infinix and Xiaomi. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Lets the wake-up alarm take over the screen instead of hiding as a
         notification. From Android 14 this is only granted by default to apps
         whose core job is an alarm, which is what this one is doing. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.StudyHub">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.StudyHub">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The alarm screen. Not exported because only our own notification
             starts it, showWhenLocked so it appears over the keyguard, and
             excludeFromRecents so it does not sit in the app switcher. -->
        <activity
            android:name=".reminder.AlarmRingActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:noHistory="false"
            android:showOnLockScreen="true"
            android:showWhenLocked="true"
            android:taskAffinity=".alarm"
            android:theme="@style/Theme.StudyHub" />

        <!-- Owns the ringtone and vibration. A notification owns only its own sound,
             so unlocking the phone used to dismiss it and silence the alarm. This
             keeps ringing until Turn off or Snooze. -->
        <service
            android:name=".reminder.AlarmService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <receiver
            android:name=".reminder.ClassAlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".reminder.DailyAlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".reminder.DeadlineAlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".reminder.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>